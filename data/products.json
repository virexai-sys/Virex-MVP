# =========================================================
# ORDER SESSION
#
# Browser/frontend থেকে session_id পাঠালে
# customer-এর order progress ধরে রাখা হবে।
# =========================================================

order_sessions = {}


def get_session(session_id):

    if not session_id:
        session_id = "default"

    if session_id not in order_sessions:

        order_sessions[session_id] = {
            "product": None,
            "size": None,
            "quantity": 1,
            "name": "",
            "phone": "",
            "address": "",
            "active": False
        }

    return order_sessions[session_id]


def update_order_session(
    session_id,
    message
):

    session = get_session(
        session_id
    )

    info = extract_order_information(
        message
    )

    if info["product"]:
        session["product"] = info["product"]

    if info["size"]:
        session["size"] = info["size"]

    if info["quantity"]:
        session["quantity"] = info["quantity"]

    # -----------------------------------------------------
    # Detect phone
    # -----------------------------------------------------

    phone_match = re.search(
        r"(?:\+?88)?01[3-9]\d{8}",
        message
    )

    if phone_match:

        session["phone"] = (
            phone_match.group(0)
        )

    return session


# =========================================================
# SAVE FINAL ORDER
# =========================================================

def save_final_order(
    session
):

    orders = get_orders()

    next_id = 1

    if orders:

        try:

            next_id = (
                max(
                    int(
                        order.get(
                            "id",
                            0
                        )
                    )
                    for order in orders
                )
                + 1
            )

        except Exception:

            next_id = len(orders) + 1

    order = {

        "id":
            next_id,

        "customer_name":
            session.get(
                "name",
                ""
            ),

        "phone":
            session.get(
                "phone",
                ""
            ),

        "address":
            session.get(
                "address",
                ""
            ),

        "product":
            session.get(
                "product"
            ) or "Not specified",

        "size":
            session.get(
                "size"
            ) or "Not specified",

        "quantity":
            session.get(
                "quantity",
                1
            ),

        "status":
            "pending",

        "created_at":
            datetime.now().isoformat()
    }

    orders.append(
        order
    )

    success = save_json_file(
        ORDER_FILE,
        orders
    )

    if not success:
        return None

    return order


