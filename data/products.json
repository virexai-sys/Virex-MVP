# =========================================================
# SIMPLE PRODUCT COMPARISON
# =========================================================

def compare_products(message):

    products = get_products()

    found = []

    normalized = normalize_text(
        message
    )

    for product in products:

        name = normalize_text(
            product.get("name", "")
        )

        if not name:
            continue

        if name in normalized:

            if product not in found:
                found.append(product)

    # aliases
    for alias, target_name in PRODUCT_ALIASES.items():

        if normalize_text(alias) in normalized:

            target = normalize_text(
                target_name
            )

            for product in products:

                if normalize_text(
                    product.get("name", "")
                ) == target:

                    if product not in found:
                        found.append(product)

    if len(found) < 2:
        return None

    return found[:3]


