# =========================================================
# OPENAI AI FALLBACK
# =========================================================

def ask_ai(
    user_message,
    context_info=""
):

    if not client:

        return (
            "এই প্রশ্নের AI response দিতে OpenAI connection "
            "প্রয়োজন। তবে আপনি product, price বা order "
            "সম্পর্কে জানতে চাইলে আমি সাহায্য করতে পারি।"
        )

    catalog = build_knowledge_base()

    user_prompt = f"""
PRODUCT CATALOG:
{catalog}

VERIFIED SHEET INFORMATION:
{context_info or "No directly matched sheet information."}

CUSTOMER MESSAGE:
{user_message}

Answer directly.
Do not invent information.
Keep the answer short.
"""

    try:

        print(
            "[OPENAI] REQUEST:",
            user_message
        )

        response = client.chat.completions.create(

            model=MODEL,

            messages=[
                {
                    "role": "system",
                    "content": SYSTEM_PROMPT
                },
                {
                    "role": "user",
                    "content": user_prompt
                }
            ],

            temperature=0.2,

            max_tokens=300
        )

        reply = (
            response
            .choices[0]
            .message
            .content
        )

        if reply:
            return reply.strip()

        return (
            "দুঃখিত, কোনো উত্তর পাওয়া যায়নি।"
        )

    except Exception as error:

        print("")
        print("=" * 60)
        print("[OPENAI ERROR]")
        print(repr(error))
        print("=" * 60)

        return (
            "AI service এই মুহূর্তে unavailable। "
            "তবে product এবং order বিষয়ে আমি সাহায্য করতে পারি।"
        )


