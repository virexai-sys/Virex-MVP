# =========================================================
# SHEET MATCHING
# =========================================================

def find_matching_sheet_answer(user_message):

    rows = get_sheet_data()

    if not rows:

        print(
            "[SHEET MATCH] No rows"
        )

        return None

    user_text = normalize_text(
        user_message
    )

    user_words = tokenize(
        user_message
    )

    # Questions that should NOT be answered
    # from generic FAQ sheet
    if find_product(user_message):

        return None

    best_answer = None
    best_score = 0
    best_question = None

    for row in rows:

        question = normalize_text(
            row.get(
                "question",
                ""
            )
        )

        keywords = normalize_text(
            row.get(
                "keywords",
                ""
            )
        )

        answer = str(
            row.get(
                "answer",
                ""
            )
        ).strip()

        if not answer:
            continue

        target_text = (
            f"{question} {keywords}"
        )

        target_words = tokenize(
            target_text
        )

        if not target_words:
            continue

        common = (
            user_words
            &
            target_words
        )

        if not common:
            continue

        # Jaccard-like similarity
        score = (
            len(common)
            /
            max(
                len(
                    user_words
                    |
                    target_words
                ),
                1
            )
        )

        # Question phrase exact-ish boost
        if question and question in user_text:
            score += 0.50

        # Keywords exact-ish boost
        keyword_list = [
            item.strip()
            for item in keywords.split()
            if item.strip()
        ]

        if keyword_list:

            matched_keywords = sum(
                1
                for keyword in keyword_list
                if keyword in user_text
            )

            if matched_keywords:
                score += (
                    0.15
                    *
                    min(
                        matched_keywords,
                        3
                    )
                )

        print(
            "[SHEET CANDIDATE]",
            question,
            "| score:",
            round(score, 3)
        )

        if score > best_score:

            best_score = score
            best_answer = answer
            best_question = question

    if best_score >= 0.35:

        print(
            "[SHEET MATCH FOUND]",
            best_question,
            "| score:",
            round(best_score, 3)
        )

        return best_answer

    print(
        "[SHEET MATCH] NO STRONG MATCH"
    )

    return None


