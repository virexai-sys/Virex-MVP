# =========================================================
# FIND PRODUCT
# =========================================================

def find_product(user_message):

    text = normalize_text(
        user_message
    )

    products = get_products()

    # Long aliases first
    aliases = sorted(
        PRODUCT_ALIASES.items(),
        key=lambda item: len(
            normalize_text(item[0])
        ),
        reverse=True
    )

    # Exact full product name
    for product in products:

        name = normalize_text(
            product.get("name", "")
        )

        if name and name in text:
            return product

    # Alias
    for alias, product_name in aliases:

        alias_normalized = normalize_text(alias)

        if alias_normalized in text:

            target = normalize_text(
                product_name
            )

            for product in products:

                current = normalize_text(
                    product.get("name", "")
                )

                if current == target:
                    return product

    return None


# =========================================================
# SIZE
# =========================================================

def detect_size(message):

    text = normalize_text(
        message
    )

    match = re.search(
        r"\b(15|30|50)\s*(?:ml|m l)?\b",
        text
    )

    if match:

        return (
            match.group(1)
            + "ml"
        )

    return None


# =========================================================
# QUANTITY
# =========================================================

def detect_quantity(message):

    text = normalize_text(
        message
    )

    patterns = [
        r"\bx\s*(\d+)\b",
        r"\bqty\s*(\d+)\b",
        r"\bquantity\s*(\d+)\b",
        r"\b(\d+)\s*(?:ta|pcs|piece|pieces)\b",
        r"পরিমাণ\s*(\d+)"
    ]

    for pattern in patterns:

        match = re.search(
            pattern,
            text
        )

        if match:

            try:
                value = int(
                    match.group(1)
                )

                if value > 0:
                    return value

            except Exception:
                pass

    return 1


# =========================================================
# PRICE QUERY
# =========================================================

def is_price_query(message):

    text = normalize_text(
        message
    )

    patterns = [
        r"\bprice\b",
        r"\bdam\b",
        r"\bkoto\b",
        r"\btaka\b",
        r"\bcost\b",
        r"\bhow much\b",
        r"দাম",
        r"কত"
    ]

    return any(
        re.search(pattern, text)
        for pattern in patterns
    )


