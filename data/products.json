    # GREETING
    # =====================================================

    if is_greeting(message):

        return jsonify({

            "reply":
                "হ্যালো! 👋 আমি EZKROY AI Assistant। "
                "কোন perfume সম্পর্কে জানতে চান?",

            "order_created":
                False,

            "type":
                "greeting"
        })


    # =====================================================
    # ORDER SESSION
    # =====================================================

    session = get_session(
        session_id
    )

    if (
        is_order_request(message)
        or session.get("active")
    ):

        session["active"] = True

        session = update_order_session(
            session_id,
            message
        )

        print(
            "[ORDER SESSION]:",
            session
        )

        # -----------------------------------------------
        # PRODUCT
        # -----------------------------------------------

        if not session.get("product"):

            return jsonify({

                "reply":
                    "অবশ্যই! 😊 কোন perfume টি নিতে চান? "
                    "যেমন: Dior Sauvage, Creed Aventus, "
                    "Vampire Blood, Hawas Fire।",

                "order_created":
                    False,

                "type":
                    "order"
            })


        # -----------------------------------------------
        # SIZE
        # -----------------------------------------------

        if not session.get("size"):

            return jsonify({

                "reply":
                    f"{session['product']} নিতে পারবেন। "
                    f"15ml নাকি 30ml চান?",

                "order_created":
                    False,

                "type":
                    "order"
            })


        # -----------------------------------------------
        # QUANTITY
        # -----------------------------------------------

        if not session.get("quantity"):

            session["quantity"] = 1


        # -----------------------------------------------
        # NAME
        # -----------------------------------------------

        if not session.get("name"):

            # If this is not obviously phone/address
            # treat simple text as name only after
            # product + size are collected.
            normalized = normalize_text(
                message
            )

            # Don't use product/size messages as name
            if (
                not product
                and not size
                and not re.search(
                    r"(?:\+?88)?01[3-9]\d{8}",
                    message
                )
                and len(
                    normalized.split()
                ) <= 5
            ):

                session["name"] = message

            else:

                return jsonify({

                    "reply":
                        "ঠিক আছে! 😊 এখন আপনার নামটি দিন।",

                    "order_created":
                        False,

                    "type":
                        "order"
                })


        # -----------------------------------------------
        # PHONE
        # -----------------------------------------------

        if not session.get("phone"):

            phone_match = re.search(
                r"(?:\+?88)?01[3-9]\d{8}",
                message
            )

            if phone_match:

                session["phone"] = (
                    phone_match.group(0)
                )

            else:

                return jsonify({

                    "reply":
                        "এখন আপনার phone number দিন।",

                    "order_created":
                        False,

                    "type":
                        "order"
                })


        # -----------------------------------------------
        # ADDRESS
        # -----------------------------------------------

        if not session.get("address"):

            # If user sends another message after phone,
            # treat it as address.
            if (
                session.get("phone")
                and message != session.get("phone")
                and not product
                and not size
            ):

                session["address"] = message

            else:

                return jsonify({

                    "reply":
                        "এখন আপনার full delivery address দিন।",

                    "order_created":
                        False,

                    "type":
                        "order"
                })


        # -----------------------------------------------
        # FINAL ORDER
        # -----------------------------------------------

        order = save_final_order(
            session
        )

        if order:

            order_sessions.pop(
                session_id,
                None
            )

            return jsonify({

                "reply":
                    "অর্ডারটি successfully নেওয়া হয়েছে! 🎉\n\n"
                    f"Product: {order['product']}\n"
                    f"Size: {order['size']}\n"
                    f"Quantity: {order['quantity']}\n"
                    f"Name: {order['customer_name']}\n"
                    f"Phone: {order['phone']}\n\n"
                    "আমাদের team order confirm করার জন্য "
                    "যোগাযোগ করবে। ❤️",

                "order_created":
                    True,

                "order":
                    order,

                "type":
                    "order_complete"
            })

        return jsonify({

            "reply":
                "Order save করতে সমস্যা হয়েছে। "
                "আবার চেষ্টা করুন।",

            "order_created":
                False,

            "type":
                "order_error"
        })


    # =====================================================
    # PRODUCT PRICE
    # =====================================================

    if (
        product
        and is_price_query(message)
    ):

        answer = build_product_answer(
            product,
            size
        )

        return jsonify({

            "reply":
                answer,

            "order_created":
                False,

            "type":
                "product_price"
        })


    # =====================================================
    # PRODUCT DETAIL
    # =====================================================

    if (
        product
        and is_product_detail_query(message)
    ):

        answer = build_product_detail_answer(
            product
        )

        return jsonify({

            "reply":
                answer,

            "order_created":
                False,

            "type":
                "product_detail"
        })


    # =====================================================
    # PRODUCT NAME ONLY
    # =====================================================

    if product:

        answer = (
            f"{product['name']} — "
            f"{product.get('description', '')}\n"
            f"15ml ৳{product.get('price_15ml')} "
            f"| 30ml ৳{product.get('price_30ml')}।"
        )

        return jsonify({

            "reply":
                answer,

            "order_created":
                False,

            "type":
                "product"
        })


    # =====================================================
    # COMPARISON
    # =====================================================

    normalized_message = normalize_text(
        message
    )

    comparison_words = [
        "konta valo",
        "kontay valo",
        "which one",
        "which is better",
        "better",
        "valo hobe",
        "ভালো হবে",
        "কোনটা ভালো"
    ]

    if any(
        word in normalized_message
        for word in comparison_words
    ):

        comparison = build_comparison_answer(
            message
        )

        if comparison:

            return jsonify({

                "reply":
                    comparison,

                "order_created":
                    False,

                "type":
                    "comparison"
            })


    # =====================================================
    # GOOGLE SHEET FAQ
    # =====================================================

    verified_answer = (
        find_matching_sheet_answer(
            message
        )
    )

    if verified_answer:

        return jsonify({

            "reply":
                verified_answer,

            "order_created":
                False,

            "type":
                "faq"
        })


    # =====================================================
    # AI FALLBACK
    # =====================================================

    reply = ask_ai(
        message,
        ""
    )

    return jsonify({

        "reply":
            reply,

        "order_created":
            False,

        "type":
            "ai"
    })


